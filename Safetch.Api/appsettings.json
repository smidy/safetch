{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Safetch": {
    "RateLimit": {
      "Limits": [
        { "MaxFetchesPerWindow": 100, "Window": "01:00:00" }
      ]
    }
  },
  "FetchOptions": {
    "MaxResponseBytes": 10485760,
    "MaxRedirects": 3,
    "TimeoutSeconds": 15
  }
}